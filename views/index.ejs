<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BusinessBuilder Nepal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .hero { background: #f8f9fa; padding: 100px 0; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">BusinessBuilder Nepal</a>
            <div>
                <% if (user) { %>
                    <a href="/dashboard" class="btn btn-outline-light">Dashboard</a>
                    <a href="/logout" class="btn btn-light">Logout</a>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-light">Login</a>
                    <a href="/register" class="btn btn-light">Register</a>
                <% } %>
            </div>
        </div>
    </nav>

    <header class="hero text-center">
        <div class="container">
            <h1 class="display-4">Create your business website in minutes.</h1>
            <p class="lead">No coding. No design skills. Simple and fast.</p>
            <a href="/register" class="btn btn-primary btn-lg">Get Started for Free</a>
        </div>
    </header>

    <section class="container my-5">
        <div class="row text-center">
            <div class="col-md-4">
                <h3>Easy Form</h3>
                <p>Just fill in your business details and upload your products.</p>
            </div>
            <div class="col-md-4">
                <h3>Instant Generate</h3>
                <p>Your website is ready the moment you click save.</p>
            </div>
            <div class="col-md-4">
                <h3>Mobile Friendly</h3>
                <p>All generated websites are beautiful on all devices.</p>
            </div>
        </div>
    </section>

    <footer class="text-center py-4 border-top">
        <p>&copy; 2025 BusinessBuilder Nepal</p>
    </footer>
</body>
</html>
